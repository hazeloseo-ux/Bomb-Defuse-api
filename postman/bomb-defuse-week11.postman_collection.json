{
  "info": {
    "name": "Bomb Defuse Week 11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "hostUser",
      "value": "2099-0001"
    },
    {
      "key": "otherHostUser",
      "value": "2099-0007"
    },
    {
      "key": "playerUser",
      "value": "2099-0002"
    },
    {
      "key": "usedSetId",
      "value": "1"
    },
    {
      "key": "setId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 List my question sets (host) - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"body is an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        }
      }
    },
    {
      "name": "02 Create a question set - 201, owner is the caller",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"host_id is the caller, not 99\", function () { pm.expect(pm.response.json().host_id).to.not.eql(99); });",
              "pm.collectionVariables.set(\"setId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Week 11 Test Set\",\n  \"description\": \"created by the collection\",\n  \"host_id\": 99\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Title too short - 400 VALIDATION_FAILED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"error code is VALIDATION_FAILED\", function () { pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_FAILED\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"ab\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Broken JSON - 400 INVALID_JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"error code is INVALID_JSON\", function () { pm.expect(pm.response.json().error.code).to.eql(\"INVALID_JSON\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Broken\"",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 No X-Demo-User header - 401 AUTH_REQUIRED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"error code is AUTH_REQUIRED\", function () { pm.expect(pm.response.json().error.code).to.eql(\"AUTH_REQUIRED\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Valid Title\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 A player calls a host endpoint - 403 FORBIDDEN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 403\", function () { pm.response.to.have.status(403); });",
              "pm.test(\"error code is FORBIDDEN\", function () { pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{playerUser}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Valid Title\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Another host reads my set - 403 FORBIDDEN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 403\", function () { pm.response.to.have.status(403); });",
              "pm.test(\"error code is FORBIDDEN\", function () { pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{otherHostUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets/{{setId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets",
            "{{setId}}"
          ]
        }
      }
    },
    {
      "name": "08 Set that does not exist - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"error code is QUESTION_SET_NOT_FOUND\", function () { pm.expect(pm.response.json().error.code).to.eql(\"QUESTION_SET_NOT_FOUND\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets",
            "999999"
          ]
        }
      }
    },
    {
      "name": "09 Update my set - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"title changed\", function () { pm.expect(pm.response.json().title).to.eql(\"Renamed By Collection\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets/{{setId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets",
            "{{setId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Renamed By Collection\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Delete my set - 204",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets/{{setId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets",
            "{{setId}}"
          ]
        }
      }
    },
    {
      "name": "11 Read the deleted set - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"error code is QUESTION_SET_NOT_FOUND\", function () { pm.expect(pm.response.json().error.code).to.eql(\"QUESTION_SET_NOT_FOUND\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets/{{setId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets",
            "{{setId}}"
          ]
        }
      }
    },
    {
      "name": "12 Delete a set used in a game - 409 QUESTION_SET_IN_USE",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () { pm.response.to.have.status(409); });",
              "pm.test(\"error code is QUESTION_SET_IN_USE\", function () { pm.expect(pm.response.json().error.code).to.eql(\"QUESTION_SET_IN_USE\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{hostUser}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets/{{usedSetId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets",
            "{{usedSetId}}"
          ]
        }
      }
    }
  ]
}